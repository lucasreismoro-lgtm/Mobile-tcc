<?xml version="1.0" encoding="utf-8" ?>
<ContentPage BackgroundColor="#0B132B" Title="Membros da Família" x:Class="dfgger.MembrosFamiliaPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label FontAttributes="Bold" FontSize="26" HorizontalOptions="Start" Text="Sua Família" TextColor="White"/>

            <Label FontSize="14" HorizontalOptions="Start" Text="Membros cadastrados na sua residência:" TextColor="#8D99AE"/>

            <ActivityIndicator Color="#48CAE4" HeightRequest="40" IsRunning="True" IsVisible="True" x:Name="LoadingIndicator"/>

            <CollectionView IsVisible="False" x:Name="CvMembros">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="#1C2541" BorderColor="#3A506B" CornerRadius="12" HasShadow="True" Margin="0,0,0,12" Padding="15">

                            <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">

                                <Frame BackgroundColor="#3A506B" BorderColor="Transparent" CornerRadius="25" Grid.Column="0" HeightRequest="50" Margin="0,0,15,0" Padding="0" WidthRequest="50">
                                    <Label FontSize="22" HorizontalOptions="Center" Text="👤" VerticalOptions="Center"/>
                                </Frame>

                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label FontAttributes="Bold" FontSize="18" Text="{Binding Nome}" TextColor="White"/>

                                    <Label FontSize="12" Text="{Binding Email}" TextColor="#8D99AE"/>
                                </VerticalStackLayout>

                                <Border BackgroundColor="#0B2545" Grid.Column="2" Padding="8,4" Stroke="#134074" StrokeShape="RoundRectangle 8" VerticalOptions="Center">
                                    <Label FontAttributes="Bold" FontSize="11" Text="{Binding CargoExibicao}" TextColor="#EEF4F8"/>
                                </Border>

                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label FontSize="14" HorizontalOptions="Center" IsVisible="False" Margin="0,20,0,0" Text="Nenhum membro cadastrado até o momento." TextColor="#8D99AE" x:Name="LblSemMembros"/>

            <Button BackgroundColor="#48CAE4" Clicked="BtnAdicionarMorador_Clicked" CornerRadius="12" FontAttributes="Bold" FontSize="16" HeightRequest="50" Margin="0,20,0,0" Text="Deseja adicionar um morador?" TextColor="#0B132B" x:Name="BtnAdicionarMorador"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>