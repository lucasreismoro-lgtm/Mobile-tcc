<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="dfgger.MembrosFamiliaPage"
             Title="Membros da Família"
             BackgroundColor="#0B132B">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Sua Família" 
                   FontSize="26" 
                   FontAttributes="Bold" 
                   TextColor="White" 
                   HorizontalOptions="Start" />

            <Label Text="Membros cadastrados na sua residência:" 
                   FontSize="14" 
                   TextColor="#8D99AE" 
                   HorizontalOptions="Start" />

            <ActivityIndicator x:Name="LoadingIndicator" 
                               IsRunning="True" 
                               IsVisible="True" 
                               Color="#48CAE4" 
                               HeightRequest="40" />

            <CollectionView x:Name="CvMembros" IsVisible="False">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="#1C2541" 
                               CornerRadius="12" 
                               HasShadow="True" 
                               Margin="0,0,0,12" 
                               Padding="15" 
                               BorderColor="#3A506B">

                            <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">

                                <Frame Grid.Column="0" 
                                       CornerRadius="25" 
                                       HeightRequest="50" 
                                       WidthRequest="50" 
                                       Padding="0" 
                                       BackgroundColor="#3A506B" 
                                       BorderColor="Transparent" 
                                       Margin="0,0,15,0">
                                    <Label Text="👤" 
                                           FontSize="22" 
                                           HorizontalOptions="Center" 
                                           VerticalOptions="Center" />
                                </Frame>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Nome}" 
                                           FontSize="18" 
                                           FontAttributes="Bold" 
                                           TextColor="White" />

                                    <Label Text="{Binding Email}" 
                                           FontSize="12" 
                                           TextColor="#8D99AE" />
                                </VerticalStackLayout>

                                <Border Grid.Column="2" 
                                        BackgroundColor="#0B2545" 
                                        Stroke="#134074" 
                                        StrokeShape="RoundRectangle 8" 
                                        Padding="8,4" 
                                        VerticalOptions="Center">
                                    <Label Text="{Binding CargoExibicao}" 
                                           FontSize="11" 
                                           FontAttributes="Bold" 
                                           TextColor="#EEF4F8" />
                                </Border>

                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label x:Name="LblSemMembros" 
                   Text="Nenhum membro cadastrado até o momento." 
                   TextColor="#8D99AE" 
                   FontSize="14" 
                   HorizontalOptions="Center" 
                   IsVisible="False" 
                   Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>