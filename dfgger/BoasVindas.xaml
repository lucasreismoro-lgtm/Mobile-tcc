<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="dfgger.BoasVindas"
             NavigationPage.HasNavigationBar="False">

    <Grid BackgroundColor="#0F172A">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0F172A" Offset="0.0"/>
                <GradientStop Color="#1E3A8A" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <VerticalStackLayout Padding="40" Spacing="10" VerticalOptions="Center">

            <Border x:Name="EscudoContainer" BackgroundColor="Transparent" StrokeThickness="0" Margin="0,0,0,20">
                <Label Text="🛡️" FontSize="90" HorizontalOptions="Center" TextColor="#60A5FA"/>
            </Border>

            <HorizontalStackLayout HorizontalOptions="Center">
                <Label Text="Security" FontSize="42" FontAttributes="Bold" TextColor="White" CharacterSpacing="1"/>
                <Label Text="+" FontSize="42" FontAttributes="Bold" TextColor="#2563EB"/>
            </HorizontalStackLayout>

            <Label Text="Inteligência que protege, tecnologia que tranquiliza." 
                   FontSize="16" 
                   TextColor="#94A3B8" 
                   HorizontalOptions="Center" 
                   Margin="0,0,0,40"
                   FontAttributes="Italic"/>

            <Button x:Name="BtnComecar" 
                    Text="Começar Monitoramento" 
                    HeightRequest="60" 
                    WidthRequest="320" 
                    CornerRadius="30" 
                    Background="#2563EB" 
                    TextColor="White" 
                    FontSize="18" 
                    FontAttributes="Bold"
                    Clicked="OnComecarClicked"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>