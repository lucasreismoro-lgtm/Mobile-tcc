<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="dfgger.LoginPage"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <!-- Fundo em Gradiente idêntico à Tela de Boas-Vindas -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0F172A" Offset="0.0"/>
                <GradientStop Color="#1E3A8A" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView Padding="24,30">
            <VerticalStackLayout Spacing="20" VerticalOptions="Center" MaximumWidthRequest="400">

                <!-- Ícone do Escudo com Borda Estilizada -->
                <Border BackgroundColor="#1E293B" 
                        Stroke="#334155" 
                        StrokeThickness="1" 
                        WidthRequest="80" 
                        HeightRequest="80" 
                        HorizontalOptions="Center" 
                        Margin="0,10,0,10"
                        StrokeShape="RoundRectangle 24">
                    <Label Text="🛡️" FontSize="42" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>

                <!-- Cabeçalho Tipográfico -->
                <VerticalStackLayout Spacing="4">
                    <HorizontalStackLayout HorizontalOptions="Center">
                        <Label Text="Security" FontSize="32" FontAttributes="Bold" TextColor="White" CharacterSpacing="1"/>
                        <Label Text="+" FontSize="32" FontAttributes="Bold" TextColor="#2563EB"/>
                    </HorizontalStackLayout>

                    <Label Text="Acesse o painel de monitoramento" 
                           FontSize="14" 
                           TextColor="#94A3B8" 
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Formulário de Entrada Profissional -->
                <VerticalStackLayout Spacing="14" Margin="0,10,0,0">

                    <!-- Campo Nome -->
                    <Border BackgroundColor="#0F172A" 
                            Stroke="#334155" 
                            StrokeThickness="1" 
                            StrokeShape="RoundRectangle 16" 
                            Padding="16,4">
                        <Entry x:Name="TxtNome" 
                               Placeholder="Nome Completo" 
                               PlaceholderColor="#64748B" 
                               TextColor="White" 
                               FontSize="15" 
                               HeightRequest="48" />
                    </Border>

                    <!-- Campo CPF -->
                    <Border BackgroundColor="#0F172A" 
                            Stroke="#334155" 
                            StrokeThickness="1" 
                            StrokeShape="RoundRectangle 16" 
                            Padding="16,4">
                        <Entry x:Name="TxtCpf" 
                               Placeholder="CPF (Apenas números)" 
                               PlaceholderColor="#64748B" 
                               TextColor="White" 
                               Keyboard="Numeric" 
                               FontSize="15" 
                               HeightRequest="48" />
                    </Border>

                    <!-- Campo CEP -->
                    <Border BackgroundColor="#0F172A" 
                            Stroke="#334155" 
                            StrokeThickness="1" 
                            StrokeShape="RoundRectangle 16" 
                            Padding="16,4">
                        <Entry x:Name="TxtCep" 
                               Placeholder="CEP (Apenas números)" 
                               PlaceholderColor="#64748B" 
                               TextColor="White" 
                               Keyboard="Numeric" 
                               FontSize="15" 
                               HeightRequest="48" />
                    </Border>

                    <!-- Campo ID Residência -->
                    <Border BackgroundColor="#0F172A" 
                            Stroke="#334155" 
                            StrokeThickness="1" 
                            StrokeShape="RoundRectangle 16" 
                            Padding="16,4">
                        <Entry x:Name="TxtIdResidencia" 
                               Placeholder="ID Residência (Código Secreto)" 
                               PlaceholderColor="#64748B" 
                               TextColor="White" 
                               FontSize="15" 
                               HeightRequest="48" />
                    </Border>

                </VerticalStackLayout>

                <!-- Botão Entrar em Pílula Arredondada -->
                <Button x:Name="BtnEntrar"
                        Text="ENTRAR NO SISTEMA" 
                        BackgroundColor="#2563EB" 
                        TextColor="White" 
                        FontAttributes="Bold" 
                        FontSize="16"
                        CharacterSpacing="1"
                        CornerRadius="25" 
                        HeightRequest="56" 
                        Margin="0,15,0,0"
                        Clicked="BtnEntrar_Clicked" />

                <!-- Indicador de Carregamento -->
                <ActivityIndicator x:Name="IndicadorCarregando" 
                                   IsRunning="False" 
                                   IsVisible="False" 
                                   Color="#60A5FA" 
                                   HorizontalOptions="Center" 
                                   Margin="0,10,0,0" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>