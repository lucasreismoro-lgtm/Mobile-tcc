<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="dfgger.LogsPage"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*">
        <!-- Fundo Gradiente -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0F172A" Offset="0.0"/>
                <GradientStop Color="#1E3A8A" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Cabeçalho com Botão Voltar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Padding="20,20,20,10" VerticalOptions="Center">
            <Button x:Name="BtnVoltar"
                    Text="←" 
                    FontSize="22" 
                    TextColor="White" 
                    BackgroundColor="Transparent" 
                    WidthRequest="45" 
                    HeightRequest="45" 
                    Clicked="OnVoltarClicked" />

            <Label Grid.Column="1" 
                   Text="Histórico de Alertas" 
                   FontSize="22" 
                   FontAttributes="Bold" 
                   TextColor="White" 
                   VerticalOptions="Center" 
                   Margin="10,0,0,0" />
        </Grid>

        <!-- Lista de Logs com nome x:Name="LogList" -->
        <CollectionView Grid.Row="1" 
                        x:Name="LogList" 
                        Margin="20,0,20,20">

            <!-- Exibido quando não há registros -->
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10" Margin="0,50,0,0">
                    <Label Text="🛡️" FontSize="48" HorizontalOptions="Center" Opacity="0.6"/>
                    <Label Text="Nenhum alerta registrado ainda." TextColor="#94A3B8" FontSize="14" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="#1E293B" 
                            Stroke="#334155" 
                            StrokeThickness="1" 
                            StrokeShape="RoundRectangle 12" 
                            Padding="14" 
                            Margin="0,0,0,10">
                        <HorizontalStackLayout Spacing="12">
                            <Label Text="⚠️" FontSize="20" VerticalOptions="Center"/>
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Titulo}" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                                <Label Text="{Binding Horario}" TextColor="#94A3B8" FontSize="12"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>